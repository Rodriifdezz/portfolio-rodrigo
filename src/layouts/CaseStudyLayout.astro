---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/case-study.css';

interface Props {
  title: string;
  discipline: string;
  context: string;
  platform: string;
  brandColor: string;
  role?: string;
  subtitle?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  discipline,
  context,
  platform,
  brandColor,
  role,
  subtitle,
  description,
  ogImage,
  noindex,
} = Astro.props;

const pageDescription =
  description ?? subtitle ?? `Caso de estudio de ${title}: ${discipline}. Proyecto de Rodrigo Fernández.`;
---

<BaseLayout
  title={`${title} — Caso de estudio | Rodrigo Fernández`}
  description={pageDescription}
  ogImage={ogImage}
  ogType="article"
  caseStudyTitle={title}
  {noindex}
>
  <Navbar />

  <main id="main-content" class="cs" style={`--cs-brand: ${brandColor};`}>
    <section class="cs-hero section-container !pb-8">
      <nav class="cs-breadcrumb" aria-label="Breadcrumb">
        <a href="/#projects">Proyectos</a>
        <span class="opacity-40" aria-hidden="true">/</span>
        <span class="text-text-secondary">{title}</span>
      </nav>

      <h1 class="cs-hero__title" data-cs-reveal>{title}</h1>

      <div class="cs-meta" data-cs-reveal>
        {role && (
          <>
            <span class="cs-brand-dot">{role}</span>
            <span class="dot" aria-hidden="true"></span>
          </>
        )}
        <span class="cs-brand-dot">{discipline}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{context}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{platform}</span>
      </div>

      {subtitle && (
        <p class="cs-lead cs-hero__lead" data-cs-reveal>
          {subtitle}
        </p>
      )}
    </section>

    <div class="section-container !pt-0 !pb-16">
      <slot />
    </div>

    <div class="section-container !py-8">
      <a href="/#projects" class="cs-back-link">
        <span aria-hidden="true">←</span> Volver a proyectos
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .cs-hero {
    padding-top: calc(var(--header-height) + 2rem);
  }

  .cs-hero__title {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 1.25rem;
  }

  .cs-hero__lead {
    margin-top: 1.5rem;
    max-width: 48rem;
  }

  .cs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .cs-breadcrumb a:hover {
    color: var(--color-text-primary);
    transition: color 0.2s ease;
  }

  .cs-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .cs-back-link:hover {
    color: var(--color-text-primary);
  }
</style>

<script>
  import { scrollReveal } from '../scripts/motion';

  scrollReveal('[data-cs-reveal]', { start: 'top 90%', y: 20, duration: 0.75 });
</script>
