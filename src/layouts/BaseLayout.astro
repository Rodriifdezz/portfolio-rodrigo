---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  noindex?: boolean;
  caseStudyTitle?: string;
}

const {
  title = site.homeTitle,
  description = site.description,
  ogImage = site.ogImage,
  ogImageWidth = site.ogImageWidth,
  ogImageHeight = site.ogImageHeight,
  ogType = 'website',
  noindex = false,
  caseStudyTitle,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.siteUrl);
const ogImagePath = ogImage.startsWith('http')
  ? ogImage
  : `${ogImage}${ogImage.includes('?') ? '&' : '?'}v=${site.ogImageVersion}`;
const ogImageURL = new URL(ogImagePath, site.siteUrl);
const showCanonical = !noindex;
const caseStudySchema = caseStudyTitle
  ? {
      title: caseStudyTitle,
      description,
      url: canonicalURL.href,
    }
  : undefined;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060816" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={site.profileImage} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    {showCanonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="me" href={site.linkedin} />

    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={`${site.name} — Portfolio`} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <SeoJsonLd caseStudy={caseStudySchema} />
  </head>
  <body class="relative min-h-screen flex flex-col bg-bg-primary text-text-primary">
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <CustomCursor />

    <div class="fixed inset-0 z-[-2] bg-grid-pattern"></div>
    <div class="fixed inset-0 z-[-1] bg-noise"></div>

    <div class="fixed inset-0 z-[-2] pointer-events-none overflow-hidden">
      <div
        class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] rounded-full bg-accent-primary/10 blur-[120px] animate-breathe mix-blend-screen"
      >
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] rounded-full bg-accent-secondary/10 blur-[120px] animate-breathe mix-blend-screen"
        style="animation-delay: 2s;"
      >
      </div>
    </div>

    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import {
        bindAnchorScroll,
        canUseSmoothScroll,
        initGsap,
        initNavScrollSpy,
        setLenis,
        tickNavScrollSpy,
      } from '../scripts/motion';

      initGsap();
      initNavScrollSpy();

      if (canUseSmoothScroll()) {
        const lenis = new Lenis({
          duration: 1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 1,
          infinite: false,
        });

        setLenis(lenis);

        lenis.on('scroll', () => {
          ScrollTrigger.update();
          tickNavScrollSpy();
        });

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      }

      bindAnchorScroll('a[href*="#"]:not([download])');
    </script>
  </body>
</html>
