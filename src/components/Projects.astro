---
import SectionLabel from './SectionLabel.astro';
import { projects, projectsSection } from '../data/site';
---

<section id="projects" class="projects section-container">
  <header class="projects__header" data-projects-header>
    <SectionLabel label="Proyectos" variant="neutral" />
    <h2 class="projects__title">{projectsSection.title}</h2>
    <p class="projects__subtitle">{projectsSection.subtitle}</p>
  </header>

  <div class="projects__list">
    {projects.map((project, index) => (
      <article
        class={`project-card project-card--${project.emphasis}`}
        data-project-id={project.id}
        style={`--accent: ${project.accentColor};`}
      >
        <div class={`project-card__grid ${index % 2 === 1 ? 'project-card__grid--reverse' : ''}`}>
          <div class="project-card__media">
            <div class="project-card__image-wrap" data-tilt>
              <div class="project-card__glow" aria-hidden="true"></div>
              <div class="project-card__frame" style={`aspect-ratio: ${project.imageAspect};`}>
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class={`project-card__img ${
                      project.id === 'inno'
                        ? 'project-card__img--banner'
                        : project.id === 'erp'
                          ? 'project-card__img--erp'
                          : ''
                    }`}
                    style={`object-position: ${project.imagePosition};`}
                    loading="lazy"
                    width={project.id === 'inno' ? 1672 : 1024}
                    height={project.id === 'inno' || project.id === 'erp' ? 576 : 500}
                  />
                ) : (
                  <div class="project-card__placeholder" aria-hidden="true">
                    <div class="project-card__placeholder-layers">
                      <span>API REST</span>
                      <span>Spring Boot</span>
                      <span>PostgreSQL</span>
                      <span>React</span>
                      <span>Electron</span>
                    </div>
                    <p class="project-card__placeholder-note">ERP en uso diario — sin capturas inventadas</p>
                  </div>
                )}
              </div>
              <span class="project-card__index" aria-hidden="true">0{index + 1}</span>
            </div>
          </div>

          <div class="project-card__content">
            <div class="project-card__meta">
              <span class="project-card__bar" aria-hidden="true"></span>
              <span class="project-card__tagline">{project.tagline}</span>
            </div>

            <h3 class="project-card__title">{project.title}</h3>

            {project.id === 'inno' && (
              <span class="project-card__badge project-card__badge--team">
                Innovatech FP · Proyecto en equipo
              </span>
            )}

            {project.id === 'erp' && (
              <span class="project-card__badge project-card__badge--backend">
                TFC de DAM · Uso real en producción
              </span>
            )}

            <p class="project-card__desc">{project.description}</p>

            <dl class="project-card__metrics">
              {Object.entries(project.metrics).map(([key, value]) => (
                <div class="project-card__metric">
                  <dt class="project-card__metric-value">{value}</dt>
                  <dd class="project-card__metric-key">{key}</dd>
                </div>
              ))}
            </dl>

            <div class="project-card__stack">
              {project.stack.map((tech) => (
                <span class="project-card__chip">{tech}</span>
              ))}
            </div>

            <a href={project.caseStudy} class="project-card__cta btn-primary">
              Ver caso de estudio
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects__header {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .projects__header :global(.section-label) {
    margin-bottom: 1rem;
  }

  .projects__title {
    font-size: var(--text-section);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }

  .projects__subtitle {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 52ch;
  }

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .projects__list {
      gap: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .projects__list {
      gap: 6rem;
    }
  }

  .project-card--primary .project-card__title {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .project-card__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .project-card__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .project-card--primary .project-card__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .project-card__grid--reverse .project-card__media {
      order: 2;
    }

    .project-card__grid--reverse .project-card__content {
      order: 1;
    }
  }

  .project-card__image-wrap {
    position: relative;
  }

  .project-card__glow {
    position: absolute;
    inset: -1rem;
    border-radius: var(--radius-xl);
    background: var(--accent);
    filter: blur(48px);
    opacity: 0.18;
    transition: opacity 0.5s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card__image-wrap:hover .project-card__glow {
      opacity: 0.32;
    }
  }

  .project-card__frame {
    position: relative;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-card);
    background: var(--color-bg-secondary);
  }

  .project-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__img--banner,
  .project-card__img--erp {
    object-fit: cover;
    object-position: center center;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card__img {
      transition: transform 0.6s ease;
    }

    .project-card__image-wrap:hover .project-card__img {
      transform: scale(1.03);
    }
  }

  .project-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    height: 100%;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 55%),
      linear-gradient(160deg, var(--color-bg-secondary), var(--color-bg-primary));
  }

  .project-card__placeholder-layers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    width: 100%;
    max-width: 16rem;
  }

  .project-card__placeholder-layers span {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.55rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
  }

  .project-card__placeholder-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    max-width: 18rem;
    line-height: 1.5;
  }

  .project-card__index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
  }

  @media (min-width: 768px) {
    .project-card__index {
      top: -0.5rem;
      left: -0.5rem;
      width: 3.5rem;
      height: 3.5rem;
      font-size: 1.25rem;
    }
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .project-card__bar {
    width: 2.5rem;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  .project-card__tagline {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .project-card__title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    transition: color 0.3s ease;
  }

  .project-card:hover .project-card__title {
    color: var(--accent);
  }

  .project-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .project-card__badge--team {
    color: #34d399;
    background: rgba(31, 169, 143, 0.15);
    border: 1px solid rgba(31, 169, 143, 0.35);
  }

  .project-card__badge--backend {
    color: var(--color-accent-primary);
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.35);
  }

  .project-card__desc {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .project-card__metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    margin: 0 0 1.25rem;
  }

  @media (min-width: 480px) {
    .project-card__metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }
  }

  .project-card__metric {
    text-align: center;
    padding: 0.85rem 0.65rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle);
  }

  .project-card__metric-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.2rem;
  }

  .project-card__metric-key {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .project-card__chip {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .project-card__cta {
    background: var(--accent) !important;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .project-card__cta:hover {
    background: var(--accent) !important;
    filter: brightness(1.08);
  }
</style>

<script>
  import { bindTilt3d, scrollReveal } from '../scripts/motion';

  scrollReveal('[data-projects-header]', { trigger: '#projects', start: 'top 85%' });
  scrollReveal('.project-card', { start: 'top 88%', y: 28 });
  bindTilt3d('[data-tilt]', 4);
</script>
