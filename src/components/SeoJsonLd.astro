---
import { site } from '../data/site';

interface CaseStudySchema {
  title: string;
  description: string;
  url: string;
}

interface Props {
  caseStudy?: CaseStudySchema;
}

const { caseStudy } = Astro.props;
const { pathname } = Astro.url;
const isHome = pathname === '/';
const profileImage = new URL(site.ogImage, site.siteUrl).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.siteUrl}/#person`,
  name: site.name,
  alternateName: site.nameAscii,
  givenName: site.givenName,
  familyName: site.familyName,
  url: site.siteUrl,
  image: profileImage,
  description: site.homeDescription,
  jobTitle: 'Desarrollador Backend',
  worksFor: {
    '@type': 'Organization',
    name: 'Viewnext',
  },
  sameAs: [site.linkedin],
  knowsAbout: [
    'Java',
    'Spring Boot',
    'React Native',
    'Backend development',
    'Mobile applications',
    'PostgreSQL',
    'Software architecture',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.siteUrl}/#website`,
  name: site.name,
  alternateName: site.nameAscii,
  url: site.siteUrl,
  description: site.homeDescription,
  inLanguage: 'es-ES',
  publisher: { '@id': `${site.siteUrl}/#person` },
  author: { '@id': `${site.siteUrl}/#person` },
};

const profilePageSchema = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      '@id': `${site.siteUrl}/#profile`,
      url: site.siteUrl,
      name: `${site.name} — Portfolio`,
      description: site.homeDescription,
      inLanguage: 'es-ES',
      isPartOf: { '@id': `${site.siteUrl}/#website` },
      mainEntity: { '@id': `${site.siteUrl}/#person` },
    }
  : null;

const caseStudySchema = caseStudy
  ? {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: caseStudy.title,
      description: caseStudy.description,
      url: caseStudy.url,
      inLanguage: 'es-ES',
      author: { '@id': `${site.siteUrl}/#person` },
      creator: { '@id': `${site.siteUrl}/#person` },
    }
  : null;

const schemas = [
  personSchema,
  ...(isHome ? [websiteSchema, profilePageSchema] : []),
  ...(caseStudySchema ? [caseStudySchema] : []),
].filter(Boolean);
---

<script type="application/ld+json" set:html={JSON.stringify(schemas)} />
