---
import {
  siSpring,
  siPostgresql,
  siMysql,
  siReact,
  siDocker,
  siTypescript,
  siFirebase,
  siFigma,
} from 'simple-icons';
import SectionLabel from './SectionLabel.astro';
import { techSection, techStack, designSection, designStack } from '../data/site';

const iconMap = {
  spring: siSpring,
  postgresql: siPostgresql,
  mysql: siMysql,
  react: siReact,
  docker: siDocker,
  typescript: siTypescript,
  firebase: siFirebase,
  figma: siFigma,
} as const;

type StackItem = (typeof techStack)[number] | (typeof designStack)[number];

function getTechColor(tech: StackItem) {
  const icon = 'iconKey' in tech ? iconMap[tech.iconKey] : null;

  if ('color' in tech && tech.color) return `#${tech.color}`;
  if (icon) return `#${icon.hex}`;
  return '#4F8CFF';
}
---

<section id="tech" class="tech section-container">
  <header class="tech__header" data-tech-header>
    <SectionLabel label="Stack" variant="secondary" />
    <h2 class="tech__title">
      {techSection.title}
      <span class="text-gradient text-gradient-animate">{techSection.titleAccent}</span>
    </h2>
    <p class="tech__subtitle">{techSection.subtitle}</p>
  </header>

  <div class="tech__grid">
    {techStack.map((tech) => {
      const icon = 'iconKey' in tech ? iconMap[tech.iconKey] : null;
      const color = getTechColor(tech);

      return (
        <article class="tech__card glass-card" data-tech-card>
          <div class="tech__icon" style={`color: ${color};`}>
            <svg role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <title>{tech.name}</title>
              {'customSvg' in tech && tech.customSvg ? (
                <path d={tech.path} />
              ) : (
                <path d={icon?.path} />
              )}
            </svg>
          </div>
          <div class="tech__body">
            <h3 class="tech__name">{tech.name}</h3>
            <p class="tech__desc">{tech.description}</p>
            <p class="tech__projects">{tech.projects}</p>
          </div>
        </article>
      );
    })}
  </div>

  <div class="tech__design" data-tech-design>
    <header class="tech__design-header">
      <h3 class="tech__design-title">{designSection.title}</h3>
      <p class="tech__design-subtitle">{designSection.subtitle}</p>
    </header>

    <div class="tech__grid">
      {designStack.map((tech) => {
        const icon = 'iconKey' in tech ? iconMap[tech.iconKey] : null;
        const color = getTechColor(tech);

        return (
          <article class="tech__card glass-card" data-tech-card>
            <div class="tech__icon" style={`color: ${color};`}>
              <svg role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <title>{tech.name}</title>
                {'customSvg' in tech && tech.customSvg ? (
                  <path d={tech.path} />
                ) : (
                  <path d={icon?.path} />
                )}
              </svg>
            </div>
            <div class="tech__body">
              <h3 class="tech__name">{tech.name}</h3>
              <p class="tech__desc">{tech.description}</p>
              <p class="tech__projects">{tech.projects}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .tech__header {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .tech__header :global(.section-label) {
    margin-inline: auto;
    margin-bottom: 1rem;
  }

  .tech__title {
    font-size: var(--text-section);
    font-weight: 700;
    line-height: 1.08;
    margin-bottom: 0.75rem;
  }

  .tech__subtitle {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .tech__design {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .tech__design-header {
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 1.75rem;
  }

  .tech__design-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.45rem;
    color: var(--color-text-primary);
  }

  .tech__design-subtitle {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .tech__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 480px) {
    .tech__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tech__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .tech__card {
    display: flex;
    gap: 1rem;
    padding: 1.1rem 1.15rem;
    align-items: flex-start;
  }

  .tech__icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
  }

  .tech__icon svg {
    width: 100%;
    height: 100%;
  }

  .tech__name {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }

  .tech__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 0.45rem;
  }

  .tech__projects {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>

<script>
  import { scrollReveal } from '../scripts/motion';

  scrollReveal('[data-tech-header]', { trigger: '#tech', start: 'top 85%' });
  scrollReveal('[data-tech-design]', { trigger: '#tech', start: 'top 75%', y: 12, duration: 0.55 });
  scrollReveal('[data-tech-card]', { trigger: '#tech', start: 'top 80%', y: 16, duration: 0.6 });
</script>
