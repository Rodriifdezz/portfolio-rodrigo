---
import { 
  siSpring, 
  siPostgresql, 
  siMysql,
  siPython,
  siReact,
  siElectron,
  siFirebase, 
  siDocker, 
  siGit,
  siTypescript
} from 'simple-icons';

const techStack = [
  { 
    name: "Java", 
    customSvg: true,
    color: "f89820",
    path: "M8.851 18.56s-.917.534.653.714c1.902.218 2.874.187 4.969-.211 0 0 .552.346 1.321.646-4.699 2.013-10.633-.118-6.943-1.149M8.276 15.933s-1.028.761.542.924c2.032.209 3.636.227 6.413-.308 0 0 .384.389.987.602-5.679 1.661-12.007.13-7.942-1.218M13.116 11.475c1.158 1.333-.304 2.533-.304 2.533s2.939-1.518 1.589-3.418c-1.261-1.772-2.228-2.652 3.007-5.688 0-.001-8.216 2.051-4.292 6.573M19.33 20.504s.679.559-.747.991c-2.712.822-11.288 1.069-13.669.033-.856-.373.75-.89 1.254-.998.527-.114.828-.093.828-.093-.953-.671-6.156 1.317-2.643 1.887 9.58 1.553 17.462-.7 14.977-1.82M9.292 13.21s-4.362 1.036-1.544 1.412c1.189.159 3.561.123 5.77-.062 1.806-.152 3.618-.477 3.618-.477s-.637.272-1.098.587c-4.429 1.165-12.986.623-10.522-.568 2.082-1.006 3.776-.892 3.776-.892M17.116 17.584c4.503-2.34 2.421-4.589.968-4.285-.355.074-.515.138-.515.138s.132-.207.385-.297c2.875-1.011 5.086 2.981-.928 4.562 0-.001.07-.062.09-.118M14.401 0s2.494 2.494-2.365 6.33c-3.896 3.077-.888 4.832-.001 6.836-2.274-2.053-3.943-3.858-2.824-5.539 1.644-2.469 6.197-3.665 5.19-7.627M9.734 23.924c4.322.277 10.959-.153 11.116-2.198 0 0-.302.775-3.572 1.391-3.688.694-8.239.613-10.937.168 0-.001.553.457 3.393.639"
  },
  { name: "Python", icon: siPython },
  { name: "Spring Boot", icon: siSpring },
  { name: "PostgreSQL", icon: siPostgresql },
  { name: "MySQL", icon: siMysql },
  { name: "React / RN", icon: siReact },
  { name: "Electron", icon: siElectron },
  { name: "TypeScript", icon: siTypescript },
  { name: "Firebase", icon: siFirebase },
  { name: "Docker", icon: siDocker },
  { name: "Git", icon: siGit }
];
---

<section id="tech" class="relative py-24 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 relative z-10">
    
    <div class="text-center mb-12" data-tech-header>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-secondary/10 border border-accent-secondary/20 backdrop-blur-sm mb-4">
        <svg class="w-3.5 h-3.5 text-accent-secondary" fill="currentColor" viewBox="0 0 20 20">
          <path d="M13 7H7v6h6V7z"/><path fill-rule="evenodd" d="M7 2a1 1 0 012 0v1h2V2a1 1 0 112 0v1h2a2 2 0 012 2v2h1a1 1 0 110 2h-1v2h1a1 1 0 110 2h-1v2a2 2 0 01-2 2h-2v1a1 1 0 11-2 0v-1H9v1a1 1 0 11-2 0v-1H5a2 2 0 01-2-2v-2H2a1 1 0 110-2h1V9H2a1 1 0 110-2h1V5a2 2 0 012-2h2V2z" clip-rule="evenodd"/>
        </svg>
        <span class="text-xs font-semibold text-accent-secondary tracking-wide">Stack</span>
      </div>
      
      <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight mb-4">
        Tecnologías que <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-secondary via-accent-primary to-accent-secondary bg-[length:200%_auto] animate-[gradient_3s_linear_infinite]">uso</span>
      </h2>
      
      <p class="text-base text-text-secondary max-w-xl mx-auto">
        Stack para desarrollo de aplicaciones empresariales y móviles
      </p>
    </div>

    <!-- Burbujitas con liquid glass -->
    <div class="flex flex-wrap justify-center gap-4">
      {techStack.map((tech, index) => (
        <div 
          class="bubble-card group"
          data-tech-card
          data-tilt-bubble
          style={`--index: ${index}; --color: ${tech.color ? '#' + tech.color : '#' + tech.icon?.hex};`}
        >
          <div class="bubble-content">
            <!-- Icon -->
            <div class="bubble-icon">
              <svg 
                role="img" 
                viewBox="0 0 24 24" 
                class="w-full h-full"
                style={`color: ${tech.color ? '#' + tech.color : '#' + tech.icon?.hex};`}
                fill="currentColor"
              >
                <title>{tech.name}</title>
                <path d={tech.customSvg ? tech.path : tech.icon?.path}/>
              </svg>
            </div>
            
            <!-- Name -->
            <span class="bubble-name">{tech.name}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .bubble-card {
    position: relative;
    opacity: 0;
    animation: bubbleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--index) * 0.08s);
  }

  .bubble-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    
    /* Liquid Glass Effect */
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    
    /* SIN transition CSS - solo GSAP para control total */
    transition: background 0.08s ease-out, border-color 0.08s ease-out, box-shadow 0.08s ease-out;
  }

  .bubble-card:hover .bubble-content {
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.08) 100%
    );
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 
      0 12px 48px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1),
      0 0 20px var(--color, rgba(255, 255, 255, 0.1));
  }

  .bubble-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.06s ease-out;
  }

  .bubble-card:hover .bubble-icon {
    transform: scale(1.15) rotate(5deg);
  }

  .bubble-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-align: center;
    transition: color 0.06s ease, transform 0.06s ease;
  }

  .bubble-card:hover .bubble-name {
    color: rgba(255, 255, 255, 1);
    transform: scale(1.05);
  }

  /* Animación de entrada tipo burbuja */
  @keyframes bubbleIn {
    0% {
      opacity: 0;
      transform: scale(0.3) translateY(50px);
    }
    50% {
      transform: scale(1.05) translateY(-5px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Animación flotante sutil */
  .bubble-card {
    animation: bubbleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
               float 6s ease-in-out infinite;
    animation-delay: calc(var(--index) * 0.08s), calc(var(--index) * 0.2s);
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('[data-tech-header]', {
    scrollTrigger: { trigger: '#tech', start: 'top 80%' },
    y: 30, opacity: 0, duration: 1, ease: 'power3.out'
  });

  const cards = document.querySelectorAll('[data-tech-card]');
  cards.forEach((card) => {
    // Set initial transform origin
    gsap.set(card, { transformOrigin: 'center center' });
    
    card.addEventListener('mouseenter', () => {
      gsap.to(card, { 
        scale: 1.1,
        y: -5,
        duration: 0.1, // MUY rápido
        ease: 'power1.out',
        overwrite: true
      });
    });
    
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { 
        scale: 1,
        y: 0,
        duration: 0.15,
        ease: 'power1.out',
        overwrite: true
      });
    });
  });

  // 3D Tilt Effect on Tech Bubbles - OPTIMIZED
  const tiltBubbles = document.querySelectorAll('[data-tilt-bubble]');
  
  tiltBubbles.forEach((bubble) => {
    let rafId: number | null = null;
    
    // Add will-change on hover
    bubble.addEventListener('mouseenter', () => {
      (bubble as HTMLElement).style.willChange = 'transform';
    });
    
    bubble.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      
      // Throttle with RAF
      if (rafId) return;
      
      rafId = requestAnimationFrame(() => {
        const rect = bubble.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -4; // Reduced to 4deg for smoother experience
        const rotateY = ((x - centerX) / centerX) * 4;
        
        gsap.to(bubble, {
          rotationX: rotateX,
          rotationY: rotateY,
          transformPerspective: 500,
          duration: 0.08, // Ultra rápido para efecto acordeón
          ease: 'power1.out',
          overwrite: 'auto'
        });
        
        rafId = null;
      });
    });
    
    bubble.addEventListener('mouseleave', () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      
      gsap.to(bubble, {
        rotationX: 0,
        rotationY: 0,
        duration: 0.12,
        ease: 'power1.out',
        overwrite: 'auto'
      });
      
      // Remove will-change
      (bubble as HTMLElement).style.willChange = 'auto';
    });
  });
</script>
