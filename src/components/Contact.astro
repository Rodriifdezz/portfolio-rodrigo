---
import SectionLabel from './SectionLabel.astro';
import { contact, site } from '../data/site';
---

<section id="contact" class="contact section-container">
  <div class="contact__inner">
    <SectionLabel label={contact.badge} variant="neutral" class="contact__badge" />

    <h2 class="contact__title">{contact.title}</h2>

    <p class="contact__text">{contact.text}</p>

    <div class="contact__actions">
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary contact__btn"
      >
        <svg class="contact__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn
      </a>

      <a href={site.cvPath} class="btn-secondary contact__btn" download>
        Descargar CV
      </a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 40rem;
    margin-inline: auto;
    padding-block: 1rem;
  }

  .contact__badge {
    max-width: 100%;
    text-wrap: balance;
    line-height: 1.4;
    padding-block: 0.5rem !important;
  }

  .contact__title {
    font-size: var(--text-section);
    font-weight: 700;
    line-height: 1.05;
  }

  .contact__text {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 48ch;
  }

  .contact__actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 480px) {
    .contact__actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
  }

  .contact__btn {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 0.9rem 1.5rem;
  }

  @media (min-width: 480px) {
    .contact__btn {
      width: auto;
    }
  }

  .contact__icon {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
