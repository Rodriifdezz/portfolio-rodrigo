---
import { Image } from 'astro:assets';
import avatarSaludo from '../assets/Saludo.png';
import MagneticButton from './MagneticButton.astro';
---

<section id="hero" class="relative h-screen flex items-center justify-center overflow-hidden">
  
  <!-- Giant Background Avatar with Cinematic Depth - RESPONSIVE -->
  <div id="cinematic-scene" class="absolute right-[-15%] sm:right-[0%] md:right-[5%] lg:right-[8%] xl:right-[5%] bottom-0 w-[130%] sm:w-[90%] md:w-[70%] lg:w-[60%] xl:w-[55%] max-w-[900px] h-[40vh] sm:h-[50vh] md:h-[60vh] lg:h-[70vh] z-0 pointer-events-auto opacity-75 sm:opacity-85 md:opacity-100">
    <!-- Glow suave y elegante detrás del avatar -->
    <div id="avatar-glow" class="absolute inset-0 bg-gradient-to-tr from-accent-primary/25 to-accent-secondary/15 rounded-full blur-[100px] animate-breathe opacity-70 glow-mask"></div>
    
    <!-- Principal Avatar (Tu imagen original) -->
    <Image 
      src={avatarSaludo} 
      alt="Avatar saludo de Rodrigo Fernández" 
      id="main-avatar"
      class="relative w-full h-full object-contain object-right-bottom drop-shadow-[0_0_40px_rgba(79,140,255,0.15)] avatar-mask origin-bottom transition-transform duration-700 ease-out z-10 opacity-0"
    />
  </div>

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 md:px-12 relative z-10 w-full max-h-[80vh] flex items-center">
    <div class="flex flex-col gap-[1.5vh] sm:gap-[2vh] md:gap-[2.5vh] max-w-3xl w-full">
      
      <!-- Badge -->
      <div data-hero-anim="badge" class="inline-flex items-center gap-2 px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-accent-primary/40 bg-accent-primary/10 w-fit backdrop-blur-md shadow-[0_0_20px_rgba(79,140,255,0.2)] opacity-0 translate-y-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-full w-full bg-accent-primary"></span>
        </span>
        <span class="text-xs md:text-sm font-semibold text-accent-primary tracking-widest uppercase">Software Engineer</span>
      </div>
      
      <!-- Huge Typography - RESPONSIVE con vh -->
      <h1 data-hero-anim="title" class="text-[8vh] sm:text-[9vh] md:text-[12vh] lg:text-[14vh] leading-[0.9] font-bold tracking-tighter opacity-0 translate-y-12">
        Rodrigo <br/> 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-primary via-white to-accent-secondary bg-[length:200%_auto] animate-[gradient_4s_linear_infinite] drop-shadow-lg inline-block">
          Fernández
        </span>
      </h1>
      
      <!-- Glassmorphism Box - Escalado con vh -->
      <div data-hero-anim="box" class="p-[2vh] sm:p-[2.5vh] md:p-[3vh] rounded-2xl md:rounded-3xl bg-bg-primary/40 backdrop-blur-xl border border-white/10 shadow-2xl max-w-2xl hover:border-accent-primary/30 transition-colors duration-500 relative z-10 opacity-0 translate-y-8">
        <h2 class="text-[2vh] sm:text-[2.2vh] md:text-[2.5vh] lg:text-[3vh] text-white font-medium mb-[1.5vh] leading-tight">
          Desarrollador software enfocado en backend, producto y aplicaciones escalables.
        </h2>
        
        <p class="text-[1.6vh] sm:text-[1.8vh] md:text-[2vh] text-text-secondary leading-relaxed mb-[2vh]">
          Construyendo sistemas y experiencias reales con Java, Spring, React Native y arquitecturas modernas.
        </p>

        <p class="hidden md:block text-[1.6vh] text-text-muted border-l-2 border-accent-primary/50 pl-4 py-1 mb-[2vh]">
          Actualmente finalizando DAM e Ingeniería Informática mientras desarrollo proyectos personales centrados en backend, cloud y experiencias digitales con identidad real.
        </p>

        <div class="flex flex-wrap items-center gap-3 md:gap-4">
          <MagneticButton href="#projects" type="primary" class="shadow-[0_0_30px_rgba(79,140,255,0.3)]">
            Ver proyectos
          </MagneticButton>
          <MagneticButton href="#contact" type="secondary" class="bg-bg-primary/50">
            Contacto
          </MagneticButton>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // 1. Text Entry Animations
  const heroElements = document.querySelectorAll('[data-hero-anim]');
  if (heroElements.length > 0) {
    gsap.to(heroElements, {
      y: 0,
      opacity: 1,
      duration: 1.2,
      stagger: 0.15,
      ease: 'power4.out',
      delay: 0.2
    });
  }

  // 1.5. Avatar Cinematic Entry Animation
  const mainAvatar = document.getElementById('main-avatar');
  if (mainAvatar) {
    gsap.fromTo(mainAvatar, 
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.8, ease: 'power3.out', delay: 0.5 }
    );
  }

  // 2. Cinematic Mouse Parallax for Avatar and Glow
  const scene = document.getElementById('cinematic-scene');
  const avatarGlow = document.getElementById('avatar-glow');

  if (scene && mainAvatar) {
    window.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;

      // Move the main avatar slightly
      gsap.to(mainAvatar, {
        x: x * 15,
        y: y * 15,
        rotationY: x * 5,
        rotationX: -y * 5,
        duration: 1,
        ease: 'power2.out'
      });

      // Move the background glow in the opposite direction for stereoscopic 3D depth
      if (avatarGlow) {
        gsap.to(avatarGlow, {
          x: -x * 25,
          y: -y * 25,
          duration: 1.5,
          ease: 'power2.out'
        });
      }
    });
  }
</script>