---
import { Image, getImage } from 'astro:assets';
import avatarSaludo from '../assets/Saludo.png';
import MagneticButton from './MagneticButton.astro';
import { site } from '../data/site';

const heroImage = await getImage({
  src: avatarSaludo,
  format: 'webp',
  width: 1400,
});
---

<link rel="preload" as="image" href={heroImage.src} type="image/webp" fetchpriority="high" />

<section id="hero" class="hero">
  <div class="hero__layout section-container">
    <div class="hero__copy">
      <div class="hero__panel" data-hero-anim>
        <p class="hero__greeting">{site.heroGreeting}</p>

        <h1 class="hero__name">
          Rodrigo<br />
          <span class="hero__surname">Fernández</span>
        </h1>

        <p class="hero__role">{site.heroRole}</p>

        <p class="hero__body">{site.heroBody}</p>

        <div class="hero__ctas">
          <MagneticButton href="#projects" type="primary">Ver proyectos</MagneticButton>
          <MagneticButton href={site.cvPath} type="secondary" download>Descargar CV</MagneticButton>
        </div>
      </div>
    </div>

    <div class="hero__visual" data-hero-anim aria-hidden="true">
      <div class="hero__photo-wrap">
        <Image
          src={avatarSaludo}
          alt=""
          class="hero__photo"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }

  .hero__layout {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    min-height: calc(100svh - var(--header-height));
    min-height: calc(100dvh - var(--header-height));
    padding-top: var(--header-height);
    padding-bottom: clamp(2rem, 5vh, 3rem);
    position: relative;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__panel {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vh, 1.1rem);
    width: 100%;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-bg-primary) 78%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-card);
  }

  .hero__greeting {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero__name {
    font-size: clamp(2.5rem, 10vw, 3.5rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.035em;
    margin: 0;
  }

  .hero__surname {
    background: linear-gradient(
      120deg,
      var(--color-accent-primary) 0%,
      #e8eeff 45%,
      var(--color-accent-secondary) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__role {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hero__body {
    font-size: clamp(0.95rem, 1.9vw, 1.05rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero__ctas :global(.btn-primary),
  .hero__ctas :global(.btn-secondary) {
    padding: 0.85rem 1.5rem;
    font-size: clamp(0.9rem, 1.8vw, 1rem);
  }

  .hero__visual {
    display: none;
  }

  @media (max-width: 374px) {
    .hero__name {
      font-size: clamp(2.2rem, 11vw, 2.6rem);
    }

    .hero__ctas :global(.btn-primary),
    .hero__ctas :global(.btn-secondary) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      min-height: 100dvh;
      display: flex;
      align-items: stretch;
    }

    .hero__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(0.75rem, 1.5vw, 1.5rem);
      align-items: center;
      min-height: 100svh;
      min-height: 100dvh;
      padding-bottom: clamp(1.5rem, 4vh, 3rem);
    }

    .hero__copy {
      padding-right: clamp(0.5rem, 1vw, 1rem);
    }

    .hero__panel {
      max-width: 36rem;
      padding: clamp(1.75rem, 2.5vw, 2.5rem);
      gap: clamp(0.85rem, 1.8vh, 1.25rem);
    }

    .hero__name {
      font-size: clamp(3.25rem, 5.5vw, 5rem);
    }

    .hero__body {
      max-width: 46ch;
    }

    .hero__visual {
      display: flex;
      position: absolute;
      left: clamp(30rem, 46%, 50%);
      right: clamp(0.5rem, 1.5vw, 1.25rem);
      width: auto;
      bottom: clamp(-1rem, -2.5vh, -1.5rem);
      height: calc((100dvh - var(--header-height)) * 0.88 + clamp(0.5rem, 1.5vh, 1rem));
      justify-content: flex-end;
      align-items: flex-end;
      z-index: 1;
      pointer-events: none;
    }

    .hero__photo-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .hero__photo-wrap::before {
      content: '';
      position: absolute;
      inset: 0 -5% -8% 0;
      background: radial-gradient(
        ellipse at 55% 88%,
        color-mix(in srgb, var(--color-accent-primary) 32%, transparent),
        transparent 78%
      );
      filter: blur(64px);
      z-index: 0;
    }

    .hero__photo {
      position: relative;
      z-index: 1;
      width: auto;
      height: 100%;
      max-width: none;
      object-fit: contain;
      object-position: right bottom;
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 38%,
        rgba(0, 0, 0, 0.95) 55%,
        rgba(0, 0, 0, 0.82) 68%,
        rgba(0, 0, 0, 0.62) 78%,
        rgba(0, 0, 0, 0.38) 88%,
        rgba(0, 0, 0, 0.16) 96%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 38%,
        rgba(0, 0, 0, 0.95) 55%,
        rgba(0, 0, 0, 0.82) 68%,
        rgba(0, 0, 0, 0.62) 78%,
        rgba(0, 0, 0, 0.38) 88%,
        rgba(0, 0, 0, 0.16) 96%,
        transparent 100%
      );
      filter: drop-shadow(0 24px 72px rgba(79, 140, 255, 0.28));
    }
  }

  @media (min-width: 1280px) {
    .hero__layout {
      gap: clamp(1rem, 2vw, 2rem);
    }

    .hero__copy {
      padding-right: clamp(0.75rem, 1.5vw, 1.25rem);
    }

    .hero__panel {
      max-width: 40rem;
    }

    .hero__name {
      font-size: clamp(3.5rem, 4.8vw, 5.25rem);
    }

    .hero__visual {
      left: clamp(34rem, 48%, 52%);
      height: calc((100dvh - var(--header-height)) * 0.9 + clamp(0.75rem, 2vh, 1.25rem));
      right: clamp(1rem, 2.5vw, 2rem);
      bottom: clamp(-1.25rem, -3vh, -2rem);
    }

    .hero__photo {
      height: 100%;
    }
  }

  @media (min-width: 1536px) {
    .hero__layout {
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
    }

    .hero__copy {
      padding-right: clamp(1rem, 2vw, 1.5rem);
    }

    .hero__visual {
      left: clamp(36rem, 50%, 54%);
      height: calc((100dvh - var(--header-height)) * 0.92 + clamp(1rem, 2.5vh, 1.5rem));
      right: max(1.5rem, calc((100vw - var(--section-max)) / -2 + 2.5rem));
    }

    .hero__photo {
      height: 100%;
    }
  }

  @media (min-width: 1920px) {
    .hero__visual {
      left: clamp(38rem, 52%, 56%);
      height: calc((100dvh - var(--header-height)) * 0.94 + clamp(1rem, 3vh, 1.75rem));
      right: max(2rem, calc((100vw - var(--section-max)) / -2 + 3rem));
      bottom: clamp(-1.5rem, -3.5vh, -2.5rem);
    }

    .hero__photo {
      height: 100%;
    }
  }
</style>

<script>
  import { canAnimate, heroEntrance } from '../scripts/motion';

  if (canAnimate()) {
    heroEntrance('[data-hero-anim]', 0.05);
  }
</script>
