---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, id, class: className } = Astro.props;
---

<section class:list={['cs-section', className]} id={id} data-cs-reveal>
  <header class="mb-10">
    <p class="cs-eyebrow">{eyebrow}</p>
    <h2 class="cs-title">{title}</h2>
    {lead && <p class="cs-lead mt-6">{lead}</p>}
  </header>
  <slot />
</section>
