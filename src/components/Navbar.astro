---
import { site } from '../data/site';

const navItems = [
  { label: 'Inicio', href: '/#hero', hash: '#hero' },
  { label: 'Sobre mí', href: '/#about', hash: '#about' },
  { label: 'Proyectos', href: '/#projects', hash: '#projects' },
  { label: 'Stack', href: '/#tech', hash: '#tech' },
  { label: 'Contacto', href: '/#contact', hash: '#contact' },
];
---

<header class="site-header">
  <div class="site-header__backdrop" aria-hidden="true"></div>

  <div class="site-header__bar">
    <a href="/#hero" class="site-header__logo">RF.</a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a href={item.href} class="nav-link" data-nav-hash={item.hash}>
            {item.label}
          </a>
        ))
      }
      <a href={site.cvPath} class="site-header__cv" download>CV</a>
    </nav>

    <button
      type="button"
      class="site-header__toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <svg class="nav-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="nav-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-nav" class="mobile-nav" aria-hidden="true">
  <button type="button" class="mobile-nav__backdrop" aria-label="Cerrar menú" data-nav-close></button>
  <nav class="mobile-nav__panel" aria-label="Menú móvil">
    {
      navItems.map((item) => (
        <a href={item.href} class="mobile-nav__link" data-nav-link data-nav-hash={item.hash}>
          {item.label}
        </a>
      ))
    }
    <a href={site.cvPath} class="mobile-nav__cta" download data-nav-link>
      Descargar CV
    </a>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
  }

  .site-header__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 8rem;
    background: linear-gradient(to bottom, var(--color-bg-primary), color-mix(in srgb, var(--color-bg-primary) 90%, transparent), transparent);
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .site-header__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--section-max);
    margin-inline: auto;
    height: var(--header-height);
    padding-inline: var(--section-px);
  }

  @media (min-width: 768px) {
    .site-header__bar {
      --section-px: 3rem;
    }
  }

  .site-header__logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-header__logo:hover {
    color: var(--color-accent-primary);
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .site-header__cv {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-header__cv:hover {
    color: var(--color-text-primary);
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    margin-right: -0.25rem;
    color: var(--color-text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .site-header__toggle:hover {
    color: var(--color-text-primary);
  }

  .nav-icon-close {
    display: none;
  }

  .site-header[data-nav-open='true'] .nav-icon-open {
    display: none;
  }

  .site-header[data-nav-open='true'] .nav-icon-close {
    display: block;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 70;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: none;
    background: color-mix(in srgb, var(--color-bg-primary) 86%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.25s ease;
    cursor: pointer;
  }

  .mobile-nav__panel {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: min(100%, 20rem);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: calc(var(--header-height) + 1rem) 1.5rem 2.5rem;
    background: var(--color-bg-secondary);
    border-left: 1px solid var(--color-border-subtle);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-nav__link {
    display: block;
    width: 100%;
    padding: 0.9rem 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: color 0.2s ease;
  }

  .mobile-nav__link:hover {
    color: var(--color-accent-primary);
  }

  .mobile-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent-primary);
    text-decoration: none;
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.35);
  }

  .mobile-nav[data-open='true'] {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav[data-open='true'] .mobile-nav__backdrop {
    opacity: 1;
  }

  .mobile-nav[data-open='true'] .mobile-nav__panel {
    transform: translateX(0);
  }

  :global(.nav-link[aria-current='page']),
  :global(.mobile-nav__link[aria-current='page']) {
    color: var(--color-accent-primary);
  }

  @media (min-width: 768px) {
    .site-header__nav {
      display: flex;
      gap: 2rem;
    }

    .site-header__toggle,
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNav = document.getElementById('mobile-nav');
  const closeTargets = mobileNav?.querySelectorAll('[data-nav-close], [data-nav-link]');

  let lastFocus: HTMLElement | null = null;

  const setOpen = (open: boolean) => {
    if (!header || !toggle || !mobileNav) return;

    if (open) {
      lastFocus = document.activeElement as HTMLElement;
    }

    header.setAttribute('data-nav-open', open ? 'true' : 'false');
    mobileNav.setAttribute('data-open', open ? 'true' : 'false');
    mobileNav.setAttribute('aria-hidden', open ? 'false' : 'true');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      const firstLink = mobileNav.querySelector<HTMLElement>('.mobile-nav__link, .mobile-nav__cta');
      firstLink?.focus();
    } else if (lastFocus) {
      lastFocus.focus();
    }
  };

  toggle?.addEventListener('click', () => {
    const isOpen = header?.getAttribute('data-nav-open') === 'true';
    setOpen(!isOpen);
  });

  closeTargets?.forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 768px)').matches) {
      setOpen(false);
    }
  });
</script>
