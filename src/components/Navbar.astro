---
const navItems = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Tecnologías', href: '#tech' },
  { label: 'Proyectos', href: '#projects' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Contacto', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 pointer-events-none">
  <!-- Smooth fade background for the navbar to avoid straight line cuts -->
  <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-bg-primary via-bg-primary/90 to-transparent backdrop-blur-[12px] [mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)] -z-10"></div>
  
  <div class="relative max-w-[1280px] mx-auto px-6 md:px-12 h-24 pt-6 flex items-start justify-between pointer-events-auto">
    <a href="#hero" class="text-xl font-bold font-display tracking-tight text-white hover:text-accent-primary transition-colors">
      RF.
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-text-secondary hover:text-white transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile Menu Button (Minimalist) -->
    <button class="md:hidden text-text-secondary hover:text-white transition-colors" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>
