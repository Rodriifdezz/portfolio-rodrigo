---
import { site } from '../data/site';

const navItems = [
  { label: 'Inicio', href: '/#hero', hash: '#hero' },
  { label: 'Sobre mí', href: '/#about', hash: '#about' },
  { label: 'Proyectos', href: '/#projects', hash: '#projects' },
  { label: 'Stack', href: '/#tech', hash: '#tech' },
  { label: 'Contacto', href: '/#contact', hash: '#contact' },
];
---

<header class="site-header fixed top-0 left-0 right-0 z-50 transition-all duration-300 pointer-events-none">
  <div
    class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-bg-primary via-bg-primary/90 to-transparent backdrop-blur-[12px] [mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)] -z-10"
  >
  </div>

  <div class="site-header__bar section-container !py-0 !px-[var(--section-px)] h-[var(--header-height)] flex items-center justify-between pointer-events-auto">
    <a
      href="/#hero"
      class="text-xl font-bold font-display tracking-tight text-white hover:text-accent-primary transition-colors"
    >
      RF.
    </a>

    <nav class="hidden md:flex items-center gap-6 lg:gap-8" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-sm font-medium text-text-secondary hover:text-white transition-colors"
            data-nav-hash={item.hash}
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.cvPath} class="text-sm font-semibold text-accent-primary hover:text-white transition-colors" download>
        CV
      </a>
    </nav>

    <button
      type="button"
      class="md:hidden text-text-secondary hover:text-white transition-colors p-1 -mr-1"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <svg class="nav-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="nav-icon-close hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav fixed inset-0 z-40 pointer-events-none opacity-0 invisible md:hidden" aria-hidden="true">
    <div class="mobile-nav__backdrop absolute inset-0 bg-bg-primary/80 backdrop-blur-md" data-nav-close></div>
    <nav
      class="mobile-nav__panel absolute top-0 right-0 h-full w-[min(100%,320px)] bg-bg-secondary/95 border-l border-white/10 px-6 pt-[calc(var(--header-height)+1rem)] pb-10 flex flex-col gap-1 shadow-2xl translate-x-full transition-transform duration-300"
      aria-label="Menú móvil"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav__link py-3 text-lg font-medium text-text-secondary hover:text-white border-b border-white/5 transition-colors"
            data-nav-link
            data-nav-hash={item.hash}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.cvPath}
        class="mt-4 inline-flex items-center justify-center px-5 py-3 rounded-full bg-accent-primary/15 border border-accent-primary/40 text-accent-primary font-semibold"
        download
        data-nav-link
      >
        Descargar CV
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header__bar {
    max-width: var(--section-max);
  }

  .site-header[data-nav-open='true'] .nav-icon-open {
    display: none;
  }

  .site-header[data-nav-open='true'] .nav-icon-close {
    display: block;
  }

  .mobile-nav[data-open='true'] {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav[data-open='true'] .mobile-nav__panel {
    transform: translateX(0);
  }

  :global(.nav-link[aria-current='page']),
  :global(.mobile-nav__link[aria-current='page']) {
    color: var(--color-text-primary);
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNav = document.getElementById('mobile-nav');
  const panel = mobileNav?.querySelector('.mobile-nav__panel');
  const closeTargets = mobileNav?.querySelectorAll('[data-nav-close], [data-nav-link]');

  let lastFocus: HTMLElement | null = null;

  const setOpen = (open: boolean) => {
    if (!header || !toggle || !mobileNav) return;

    if (open) {
      lastFocus = document.activeElement as HTMLElement;
    }

    header.setAttribute('data-nav-open', open ? 'true' : 'false');
    mobileNav.setAttribute('data-open', open ? 'true' : 'false');
    mobileNav.setAttribute('aria-hidden', open ? 'false' : 'true');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      const firstLink = panel?.querySelector<HTMLElement>('a, button');
      firstLink?.focus();
    } else if (lastFocus) {
      lastFocus.focus();
    }
  };

  toggle?.addEventListener('click', () => {
    const isOpen = header?.getAttribute('data-nav-open') === 'true';
    setOpen(!isOpen);
  });

  closeTargets?.forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);

    if (e.key === 'Tab' && header?.getAttribute('data-nav-open') === 'true' && panel) {
      const focusable = panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  panel?.addEventListener('click', (e) => e.stopPropagation());
</script>
