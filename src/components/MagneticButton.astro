---
interface Props {
  href?: string;
  class?: string;
  type?: 'primary' | 'secondary';
  download?: boolean | string;
}

const { href, class: className = '', type = 'primary', download } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  download={download}
  class={`magnetic-button ${type === 'primary' ? 'btn-primary' : 'btn-secondary'} ${className}`}
  data-magnetic
>
  <span class="magnetic-content">
    <slot />
  </span>
</Tag>

<style>
  .magnetic-button {
    position: relative;
  }

  .magnetic-content {
    display: inline-block;
  }
</style>

<script>
  import { bindMagnetic } from '../scripts/motion';

  bindMagnetic('[data-magnetic]');
</script>
