---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseStudySection from '../../components/case-study/CaseStudySection.astro';
import LazyVideo from '../../components/case-study/LazyVideo.astro';

const brand = '#1FA98F';

const journey = [
  { emoji: '🌿', label: 'Descubrir', desc: 'El producto en tienda' },
  { emoji: '📱', label: 'Escanear', desc: 'QR en el envase' },
  { emoji: '📖', label: 'Aprender', desc: 'Sobre cada alga' },
  { emoji: '✨', label: 'Cocinar', desc: 'Recetas con IA' },
  { emoji: '🧺', label: 'Despensa', desc: 'Favoritos y stock' },
  { emoji: '👨‍🍳', label: 'Confianza', desc: 'Animarse a probar' },
];

const gallery = [
  { img: '/innovatech/screen-11.png', caption: 'Escanear QR' },
  { img: '/innovatech/screen-06.png', caption: 'Producto detectado' },
  { img: '/innovatech/screen-07.png', caption: 'Ficha de producto' },
  { img: '/innovatech/screen-04.png', caption: 'Receta paso a paso' },
  { img: '/innovatech/screen-05.png', caption: 'AlgaeChef' },
  { img: '/innovatech/screen-02.png', caption: 'Inicio' },
];

const screens = [
  {
    index: '01',
    img: '/innovatech/screen-11.png',
    title: 'Escanear el QR del producto',
    problem: 'El usuario compra en tienda pero no sabe qué hacer después. Falta el puente entre lo físico y lo digital.',
    why: 'El escáner conecta el envase con una experiencia personalizada al instante, sin buscar la app manualmente.',
  },
  {
    index: '02',
    img: '/innovatech/screen-06.png',
    title: 'Información clara del producto',
    problem: '¿Qué alga estoy comprando? ¿Para qué sirve? La incertidumbre frena la compra.',
    why: 'Tras escanear, ficha con descripción, valoración, precio y receta recomendada. Reduce la barrera en el momento de decidir.',
  },
  {
    index: '03',
    img: '/innovatech/screen-04.png',
    title: 'Recetas con estructura clara',
    problem: 'El clásico "¿y ahora qué hago con esto?" después de comprar un producto desconocido.',
    why: 'Ingredientes y pasos en pestañas, foto apetecible. Baja la fricción de empezar a cocinar.',
  },
  {
    index: '04',
    img: '/innovatech/screen-05.png',
    title: 'AlgaeChef — recetas con IA',
    problem: 'Cocinar con algas requiere conocimiento que la mayoría no tiene.',
    why: 'Sugerencias adaptadas al despensa, recomendaciones de algas y recetas generadas según lo que tienes.',
  },
  {
    index: '05',
    img: '/innovatech/screen-02.png',
    title: 'Inicio — descubrir y volver',
    problem: 'Sin un hub central, cada visita empieza de cero y la experiencia no mejora.',
    why: 'Recetas destacadas, productos y acceso directo a AlgaeChef. Favoritos y despensa construyen hábito.',
  },
];
---

<CaseStudyLayout
  title="Innovatech FP × Porto-Muiños"
  subtitle="Diseñando una experiencia digital para acercar el consumo de algas al día a día."
  role="Diseño de producto · Equipo"
  discipline="Producto digital · Cliente real"
  context="Cliente real · Equipo"
  platform="App móvil · IA"
  brandColor={brand}
  description="Caso de estudio de Porto-Muiños: app móvil con escaneo QR, recetas e IA (AlgaeChef) para Innovatech FP. Cliente real Porto-Muiños."
  ogImage="/innovatech/concept.jpeg"
>
  <CaseStudySection eyebrow="Introducción" title="Un reto de empresa, una respuesta de producto">
    <p class="cs-prose">
      Durante Innovatech FP trabajamos junto a <strong>Porto-Muiños</strong>, empresa referente en Europa
      en el cultivo y comercialización de algas, con un reto muy concreto: hacer que un producto
      desconocido para la mayoría de consumidores resultara más <strong>accesible, comprensible y fácil
      de incorporar a la cocina diaria</strong>.
    </p>
    <p class="cs-prose">
      Nuestra propuesta combinó diseño de producto, inteligencia artificial y una experiencia móvil
      centrada en descubrir, aprender y cocinar con algas de una forma sencilla.
    </p>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="01 — El reto"
    title="Un gran producto no siempre significa una experiencia sencilla"
  >
    <p class="cs-prose">
      Porto-Muiños llevaba años innovando en torno a las algas como alimento, pero seguía existiendo
      una barrera evidente: la mayoría de personas no sabía qué hacer con ellas.
    </p>
    <div class="cs-observations mt-8">
      <div class="cs-observation">
        <span class="cs-observation__num">?</span>
        <p class="cs-observation__text">¿Qué tipo de alga estoy comprando?</p>
      </div>
      <div class="cs-observation">
        <span class="cs-observation__num">?</span>
        <p class="cs-observation__text">¿Para qué sirve?</p>
      </div>
      <div class="cs-observation">
        <span class="cs-observation__num">?</span>
        <p class="cs-observation__text">¿Cómo se cocina?</p>
      </div>
      <div class="cs-observation">
        <span class="cs-observation__num">?</span>
        <p class="cs-observation__text">¿Con qué ingredientes combina?</p>
      </div>
    </div>
    <p class="cs-lead mt-10">
      El problema no era el producto. Era la <strong>experiencia que existía alrededor del producto</strong>.
      Ese fue el punto de partida del proyecto.
    </p>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="02 — Investigación"
    title="Entender antes de diseñar"
    lead="Antes de pensar en pantallas o funcionalidades, dedicamos tiempo a comprender el contexto."
  >
    <p class="cs-prose">
      Observamos cómo una persona descubre un producto nuevo en un supermercado, qué dudas aparecen
      durante la compra y por qué muchas veces termina descartándolo.
    </p>
    <p class="cs-prose">
      Identificamos un patrón claro: cuando un alimento requiere <strong>demasiado aprendizaje previo</strong>,
      la mayoría de consumidores abandona antes incluso de probarlo.
    </p>
    <p class="cs-lead mt-8">
      La oportunidad no estaba en vender más. Estaba en <strong>reducir esa barrera inicial</strong>.
    </p>
  </CaseStudySection>
  <CaseStudySection eyebrow="03 — La pregunta" title="La pregunta que guió el proyecto">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <p class="cs-quote">
        ¿Cómo conseguimos que cualquiera pueda empezar a <span>cocinar con algas</span> sin sentirse perdido?
      </p>
      <div>
        <p class="cs-prose">
          Esa fue la pregunta que guió todas las decisiones posteriores.
        </p>
        <p class="cs-prose">
          No buscábamos crear otra aplicación. Queríamos diseñar una experiencia que acompañara al
          usuario desde el <strong>primer contacto con el producto</strong> hasta el momento de cocinarlo.
        </p>
      </div>
    </div>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="04 — La solución"
    title="Conectar el producto físico con el mundo digital"
  >
    <p class="cs-lead">
      Una aplicación móvil capaz de acompañar al usuario durante todo el recorrido. Mediante el escaneo
      de un <strong>código QR</strong> en el producto, accedía a una experiencia personalizada: información
      sobre cada alga, propiedades, recomendaciones y recetas adaptadas mediante <strong>inteligencia artificial</strong>.
    </p>
    <p class="cs-prose mt-6">
      El objetivo no era sustituir la experiencia de compra. Era <strong>enriquecerla</strong>.
    </p>

    <div class="cs-figure mt-14">
      <img src="/innovatech/concept.jpeg" alt="Porto-Muiños — mapa de la experiencia" loading="lazy" decoding="async" />
    </div>
    <p class="cs-figcaption">Vista general del recorrido: descubrir, escanear, aprender y cocinar.</p>

    <div class="mt-16" data-cs-reveal>
      <LazyVideo
        src="/innovatech/demo.mp4"
        poster="/innovatech/concept.jpeg"
        label="Ver prototipo en movimiento"
        aspect="16 / 9"
      />
    </div>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="05 — Experiencia"
    title="Un recorrido natural"
    lead="Cada paso elimina una pequeña barrera que normalmente impide probar un alimento desconocido."
  >
    <div class="cs-journey">
      {journey.map((step) => (
        <div class="cs-journey__step">
          <div class="cs-journey__node">{step.emoji}</div>
          <span class="cs-journey__label">{step.label}</span>
          <span class="cs-journey__desc">{step.desc}</span>
        </div>
      ))}
    </div>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="06 — Decisiones de diseño"
    title="Cada pantalla respondía a una pregunta del usuario"
    lead="No diseñamos funcionalidades porque sí. Cada una resolvía una necesidad concreta."
  >
    <div class="cs-decisions">
      <div class="cs-decision">
        <p class="cs-decision__q">Información clara del producto</p>
        <div class="cs-decision__body">
          <div class="cs-decision__row">
            <span class="cs-decision__key">Problema</span>
            <span class="cs-decision__val">Incertidumbre en el momento de la compra.</span>
          </div>
          <div class="cs-decision__row cs-decision__row--outcome">
            <span class="cs-decision__key">Resultado</span>
            <span class="cs-decision__val">El usuario entiende qué compra antes de llevarlo a casa.</span>
          </div>
        </div>
      </div>
      <div class="cs-decision">
        <p class="cs-decision__q">Recetas generadas mediante IA</p>
        <div class="cs-decision__body">
          <div class="cs-decision__row">
            <span class="cs-decision__key">Problema</span>
            <span class="cs-decision__val">El clásico "¿y ahora qué hago con esto?"</span>
          </div>
          <div class="cs-decision__row cs-decision__row--outcome">
            <span class="cs-decision__key">Resultado</span>
            <span class="cs-decision__val">AlgaeChef propone recetas adaptadas al despensa del usuario.</span>
          </div>
        </div>
      </div>
      <div class="cs-decision">
        <p class="cs-decision__q">Mi despensa</p>
        <div class="cs-decision__body">
          <div class="cs-decision__row">
            <span class="cs-decision__key">Problema</span>
            <span class="cs-decision__val">Productos comprados que se olvidan en la cocina.</span>
          </div>
          <div class="cs-decision__row cs-decision__row--outcome">
            <span class="cs-decision__key">Resultado</span>
            <span class="cs-decision__val">Fomentar la reutilización y aprovechar lo que ya tienes.</span>
          </div>
        </div>
      </div>
      <div class="cs-decision">
        <p class="cs-decision__q">Favoritos</p>
        <div class="cs-decision__body">
          <div class="cs-decision__row">
            <span class="cs-decision__key">Problema</span>
            <span class="cs-decision__val">Sin memoria, cada sesión empieza de cero.</span>
          </div>
          <div class="cs-decision__row cs-decision__row--outcome">
            <span class="cs-decision__key">Resultado</span>
            <span class="cs-decision__val">Una experiencia que mejora con el tiempo y genera hábito.</span>
          </div>
        </div>
      </div>
    </div>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="07 — Pantallas del producto"
    title="Pantallas que cuentan la historia"
    lead="El recorrido completo, de izquierda a derecha: escanear, aprender, cocinar y volver al inicio."
  >
    <div class="cs-mockup-grid" data-cs-reveal>
      {gallery.map((item) => (
        <figure class="cs-mockup-grid__item">
          <img src={item.img} alt={`Porto-Muiños — ${item.caption}`} loading="lazy" decoding="async" />
          <figcaption class="cs-mockup-grid__caption">{item.caption}</figcaption>
        </figure>
      ))}
    </div>

    {screens.map((screen, i) => (
      <article class={`cs-screen ${i % 2 === 1 ? 'cs-screen--flip' : ''}`} data-cs-reveal>
        <div class="cs-screen__media">
          <div class="cs-screen__mockup">
            <img src={screen.img} alt={`Porto-Muiños — ${screen.title}`} loading="lazy" decoding="async" />
          </div>
        </div>
        <div>
          <p class="cs-screen__index">{screen.index}</p>
          <h3 class="cs-screen__title">{screen.title}</h3>
          <dl>
            <div class="cs-screen__annotation">
              <dt>Qué resuelve</dt>
              <dd>{screen.problem}</dd>
            </div>
            <div class="cs-screen__annotation">
              <dt>Por qué así</dt>
              <dd>{screen.why}</dd>
            </div>
          </dl>
        </div>
      </article>
    ))}
  </CaseStudySection>
  <CaseStudySection
    eyebrow="08 — Cliente real"
    title="Diseñar cambia cuando existe un cliente al otro lado"
  >
    <p class="cs-lead">
      Uno de los mayores aprendizajes fue trabajar sobre un reto planteado por una <strong>empresa real</strong>.
    </p>
    <p class="cs-prose mt-6">
      Cada decisión debía justificarse. Cada funcionalidad debía aportar valor. Cada presentación
      suponía explicar por qué una idea era mejor que otra. El proyecto dejó de ser un ejercicio
      académico para convertirse en un <strong>proceso de diseño orientado a resolver un problema existente</strong>.
    </p>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="09 — Innovatech FP"
    title="Mucho más que una competición"
  >
    <p class="cs-prose">
      Innovatech FP nos permitió trabajar bajo un contexto muy similar al de un proyecto profesional:
      investigar un problema real, desarrollar una propuesta, iterar sobre ella y defenderla ante un
      jurado formado por profesionales.
    </p>
    <p class="cs-prose">
      Más allá del resultado obtenido, la experiencia nos enseñó la importancia de <strong>validar ideas</strong>,
      comunicar decisiones y construir soluciones pensando siempre en el usuario final.
    </p>
  </CaseStudySection>
  <CaseStudySection
    eyebrow="10 — Resultado"
    title="Facilitar la adopción de un producto poco conocido"
  >
    <p class="cs-lead">
      Un prototipo funcional que integraba contenido educativo, recetas generadas mediante inteligencia
      artificial y herramientas para acompañar al usuario antes, durante y después de la compra.
    </p>
    <p class="cs-prose mt-6">
      La propuesta fue presentada dentro del programa <strong>Innovatech FP</strong> como respuesta
      al reto planteado por Porto-Muiños.
    </p>

    <div class="cs-figure cs-figure--poster mt-14">
      <img src="/innovatech/hero.png" alt="Porto-Muiños — memoria final Innovatech FP" loading="lazy" decoding="async" />
    </div>
    <p class="cs-figcaption">Portada de la memoria del proyecto — curso 2024/2025.</p>
  </CaseStudySection>
  <CaseStudySection eyebrow="11 — Aprendizajes" title="Lo que me llevo de este proyecto">
    <div class="cs-lessons">
      <div class="cs-lesson">
        <span class="cs-lesson__num">01</span>
        <div>
          <h3 class="cs-lesson__title">El diseño empieza por comprender el problema</h3>
          <p class="cs-lesson__text">
            El diseño de producto no consiste únicamente en crear interfaces atractivas. Consiste en
            comprender un problema, cuestionar su origen y construir una solución capaz de mejorar
            la experiencia de las personas.
          </p>
        </div>
      </div>
      <div class="cs-lesson">
        <span class="cs-lesson__num">02</span>
        <div>
          <h3 class="cs-lesson__title">La tecnología debe desaparecer</h3>
          <p class="cs-lesson__text">
            Trabajar con Porto-Muiños reforzó una idea que hoy guía todos mis proyectos: la mejor
            tecnología es aquella que desaparece y deja que la experiencia sea la protagonista.
          </p>
        </div>
      </div>
    </div>
  </CaseStudySection>

</CaseStudyLayout>
