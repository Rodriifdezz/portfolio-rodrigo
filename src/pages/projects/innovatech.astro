---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
---

<CaseStudyLayout
  title="InnovaTech"
  tagline="Concurso Nacional"
  description="Propuesta de producto funcional seleccionada como finalista para el prestigioso premio nacional Innovatech. Diseño de interfaz impecable con memoria técnica rigurosa."
  accentColor="#F59E0B"
  heroImage="/innovatech/ChatGPT Image 22 may 2026, 15_48_16.png"
  stack={["UI/UX Design", "Figma", "Prototipado", "User Research", "Design Systems"]}
  metrics={{
    prize: "€10K",
    position: "Finalista",
    year: "2024"
  }}
  github="https://github.com/Rodriifdezz"
  year="2024"
>

  <!-- Award Badge -->
  <section class="mb-16 -mt-8">
    <div class="glass-card p-8 text-center">
      <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-gradient-to-r from-amber-500/20 to-orange-500/20 border border-amber-500/30 backdrop-blur-sm">
        <svg class="w-6 h-6 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <span class="text-lg font-bold text-amber-400">Premio Nacional Innovatech • €10,000 • Finalista 2024</span>
      </div>
    </div>
  </section>

  <!-- Hero Screens Section -->
  <section class="mb-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      <div class="screen-container">
        <img src="/innovatech/Frame 1.png" alt="InnovaTech - Pantalla principal" class="screen-image" loading="eager"/>
      </div>
      <div class="screen-container">
        <img src="/innovatech/Frame 1 (1).png" alt="InnovaTech - Dashboard" class="screen-image" loading="eager"/>
      </div>
      <div class="screen-container">
        <img src="/innovatech/Frame 1 (2).png" alt="InnovaTech - Analytics" class="screen-image" loading="eager"/>
      </div>
      <div class="screen-container">
        <img src="/innovatech/Frame 1 (3).png" alt="InnovaTech - Settings" class="screen-image" loading="eager"/>
      </div>
    </div>
  </section>

  <!-- El Contexto -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">🏆</span>
      El Contexto
    </h2>
    <div class="glass-card p-8 space-y-4 text-text-secondary">
      <p class="text-lg leading-relaxed">
        Innovatech es el <strong class="text-white">premio nacional más prestigioso</strong> para jóvenes innovadores 
        tecnológicos en España. Con más de 500 participantes cada año, solo los 10 mejores proyectos llegan a la final.
      </p>
      <p class="text-lg leading-relaxed">
        La propuesta debía demostrar <strong class="text-white">viabilidad técnica, impacto social y excelencia en diseño</strong>. 
        Cada proyecto se evalúa por un jurado de expertos de la industria tecnológica.
      </p>
      <div class="mt-6 p-6 rounded-xl bg-[#F59E0B]/10 border-l-4 border-[#F59E0B]">
        <p class="text-xl font-bold text-white italic">
          "Entre los 10 finalistas de 500+ participantes a nivel nacional"
        </p>
      </div>
    </div>
  </section>

  <!-- El Reto -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">🎯</span>
      El Reto
    </h2>
    <div class="glass-card p-8 space-y-6">
      <p class="text-lg text-text-secondary leading-relaxed">
        Diseñar una solución tecnológica completa que resuelva un problema real, con:
      </p>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="challenge-card-inno">
          <div class="text-4xl mb-4">📐</div>
          <h3 class="text-xl font-bold text-white mb-3">Diseño Impecable</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Interfaz profesional que cumpla estándares de usabilidad y accesibilidad. 
            Diseño visual coherente y atractivo.
          </p>
        </div>
        <div class="challenge-card-inno">
          <div class="text-4xl mb-4">📄</div>
          <h3 class="text-xl font-bold text-white mb-3">Memoria Técnica</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Documentación rigurosa de arquitectura, tecnologías, metodología 
            y plan de implementación detallado.
          </p>
        </div>
        <div class="challenge-card-inno">
          <div class="text-4xl mb-4">💡</div>
          <h3 class="text-xl font-bold text-white mb-3">Innovación Real</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Propuesta diferenciadora que aporte valor real al mercado. 
            Solución viable y escalable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Diseño UI/UX -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">🎨</span>
      Diseño UI/UX
    </h2>
    
    <div class="glass-card p-8 mb-8">
      <p class="text-lg text-text-secondary leading-relaxed mb-6">
        Sistema de diseño completo desarrollado en <strong class="text-white">Figma</strong>, 
        con componentes reutilizables, guías de estilo y prototipo interactivo de alta fidelidad.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="design-feature">
          <h4 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-2xl">🎯</span>
            Design System
          </h4>
          <ul class="text-sm space-y-2 text-text-secondary list-none">
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Paleta de colores coherente y accesible</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Tipografía escalable y legible</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Componentes modulares reutilizables</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Sistema de espaciado consistente</span>
            </li>
          </ul>
        </div>

        <div class="design-feature">
          <h4 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-2xl">⚡</span>
            Prototipado
          </h4>
          <ul class="text-sm space-y-2 text-text-secondary list-none">
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Prototipo interactivo navegable</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Flujos de usuario optimizados</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Micro-interacciones y transiciones</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Testing con usuarios reales</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Screens Showcase -->
    <div class="glass-card p-8">
      <h3 class="text-2xl font-bold text-white mb-6">Pantallas Principales</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (4).png" alt="InnovaTech - Onboarding" class="screen-full"/>
          <p class="screen-caption">Onboarding</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (5).png" alt="InnovaTech - Dashboard" class="screen-full"/>
          <p class="screen-caption">Dashboard</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (6).png" alt="InnovaTech - Analytics" class="screen-full"/>
          <p class="screen-caption">Analytics</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (7).png" alt="InnovaTech - Profile" class="screen-full"/>
          <p class="screen-caption">Profile</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (8).png" alt="InnovaTech - Settings" class="screen-full"/>
          <p class="screen-caption">Settings</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (9).png" alt="InnovaTech - Notifications" class="screen-full"/>
          <p class="screen-caption">Notifications</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Más Pantallas -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">📱</span>
      Flujos Completos
    </h2>
    
    <div class="glass-card p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (10).png" alt="InnovaTech - Flow 1" class="screen-full"/>
          <p class="screen-caption">User Flow 1</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (11).png" alt="InnovaTech - Flow 2" class="screen-full"/>
          <p class="screen-caption">User Flow 2</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 1 (12).png" alt="InnovaTech - Flow 3" class="screen-full"/>
          <p class="screen-caption">User Flow 3</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 2 (1).png" alt="InnovaTech - Components" class="screen-full"/>
          <p class="screen-caption">Components</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/Frame 2 (2).png" alt="InnovaTech - Style Guide" class="screen-full"/>
          <p class="screen-caption">Style Guide</p>
        </div>
        <div class="screen-showcase">
          <img src="/innovatech/ChatGPT_Image_27_may_2026,_202605291120.jpeg" alt="InnovaTech - Concept" class="screen-full"/>
          <p class="screen-caption">Concept Art</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Metodología -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">🔬</span>
      Metodología de Diseño
    </h2>
    
    <div class="space-y-6">
      <div class="methodology-card">
        <div class="flex items-start gap-4">
          <div class="methodology-number">1</div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Research & Discovery</h3>
            <p class="text-text-secondary leading-relaxed">
              Investigación de usuarios, análisis competitivo, identificación de pain points. 
              Entrevistas con stakeholders y definición de user personas.
            </p>
          </div>
        </div>
      </div>

      <div class="methodology-card">
        <div class="flex items-start gap-4">
          <div class="methodology-number">2</div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Ideation & Wireframing</h3>
            <p class="text-text-secondary leading-relaxed">
              Sketches iniciales, wireframes low-fidelity, arquitectura de información. 
              Iteración rápida basada en feedback.
            </p>
          </div>
        </div>
      </div>

      <div class="methodology-card">
        <div class="flex items-start gap-4">
          <div class="methodology-number">3</div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Visual Design</h3>
            <p class="text-text-secondary leading-relaxed">
              Creación del design system, mockups high-fidelity, definición de brand identity. 
              Asegurar consistencia visual en todas las pantallas.
            </p>
          </div>
        </div>
      </div>

      <div class="methodology-card">
        <div class="flex items-start gap-4">
          <div class="methodology-number">4</div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Prototyping & Testing</h3>
            <p class="text-text-secondary leading-relaxed">
              Prototipo interactivo en Figma, testing de usabilidad con usuarios, 
              ajustes basados en métricas y feedback cualitativo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Memoria Técnica -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">📋</span>
      Memoria Técnica
    </h2>
    
    <div class="glass-card p-8">
      <p class="text-lg text-text-secondary leading-relaxed mb-6">
        Documentación completa presentada al jurado, incluyendo arquitectura técnica, 
        plan de desarrollo y estrategia de go-to-market.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="technical-section">
          <h4 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-2xl">🏗️</span>
            Arquitectura
          </h4>
          <ul class="text-sm space-y-2 text-text-secondary list-none">
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Diagrama de arquitectura completo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Stack tecnológico justificado</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Modelo de datos y relaciones</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Infraestructura y escalabilidad</span>
            </li>
          </ul>
        </div>

        <div class="technical-section">
          <h4 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-2xl">📊</span>
            Plan de Negocio
          </h4>
          <ul class="text-sm space-y-2 text-text-secondary list-none">
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Análisis de mercado y competencia</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Modelo de monetización</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Roadmap de desarrollo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#F59E0B] mt-0.5">→</span>
              <span>Proyección financiera a 3 años</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Aprendizajes -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">💎</span>
      Lo que aprendí
    </h2>
    
    <div class="glass-card p-8">
      <div class="space-y-4 text-text-secondary">
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">Diseño de Producto:</strong> Proceso completo desde research hasta prototipo final, validación con usuarios, iteración basada en feedback</p>
          </div>
        </div>
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">Figma Avanzado:</strong> Design systems, componentes, auto-layout, prototyping interactivo, colaboración en equipo</p>
          </div>
        </div>
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">User Research:</strong> Entrevistas, análisis cualitativo, definición de personas, journey mapping, testing de usabilidad</p>
          </div>
        </div>
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">Documentación Técnica:</strong> Redacción de memoria técnica profesional, diagramas de arquitectura, justificación de decisiones</p>
          </div>
        </div>
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">Presentación:</strong> Pitch ante jurado experto, storytelling, defensa de propuesta, gestión de Q&A</p>
          </div>
        </div>
        <div class="learning-item">
          <span class="text-[#F59E0B] text-2xl">→</span>
          <div>
            <p class="text-lg"><strong class="text-white">Trabajo bajo presión:</strong> Cumplir deadlines estrictos, gestión de tiempo, priorización de tareas críticas</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reconocimiento -->
  <section class="mb-20">
    <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-3">
      <span class="text-4xl">🏅</span>
      Reconocimiento
    </h2>
    
    <div class="glass-card p-8">
      <div class="text-center space-y-6">
        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-5xl">
          🏆
        </div>
        <div>
          <h3 class="text-3xl font-bold text-white mb-2">Finalista Nacional</h3>
          <p class="text-xl text-amber-400 font-semibold mb-4">Premio Innovatech 2024</p>
          <p class="text-text-secondary max-w-2xl mx-auto leading-relaxed">
            Seleccionado entre más de 500 participantes a nivel nacional. 
            El proyecto destacó por su <strong class="text-white">excelencia en diseño UI/UX</strong>, 
            <strong class="text-white">viabilidad técnica</strong> y 
            <strong class="text-white">potencial de impacto social</strong>.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <div class="px-6 py-3 rounded-xl bg-amber-500/10 border border-amber-500/30">
            <div class="text-2xl font-bold text-amber-400">€10,000</div>
            <div class="text-xs text-text-muted uppercase">Premio</div>
          </div>
          <div class="px-6 py-3 rounded-xl bg-amber-500/10 border border-amber-500/30">
            <div class="text-2xl font-bold text-amber-400">Top 10</div>
            <div class="text-xs text-text-muted uppercase">Finalista</div>
          </div>
          <div class="px-6 py-3 rounded-xl bg-amber-500/10 border border-amber-500/30">
            <div class="text-2xl font-bold text-amber-400">500+</div>
            <div class="text-xs text-text-muted uppercase">Participantes</div>
          </div>
        </div>
      </div>
    </div>
  </section>

</CaseStudyLayout>

<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
  }

  .screen-container {
    position: relative;
    aspect-ratio: 16/10;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .screen-container:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(245, 158, 11, 0.3);
  }

  .screen-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .screen-showcase {
    position: relative;
    transition: transform 0.3s ease;
  }

  .screen-showcase:hover {
    transform: translateY(-8px);
  }

  .screen-full {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .screen-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 600;
  }

  .challenge-card-inno {
    padding: 2rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .challenge-card-inno:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(245, 158, 11, 0.3);
    transform: translateY(-4px);
  }

  .design-feature {
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border-left: 4px solid #F59E0B;
  }

  .methodology-card {
    padding: 2rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .methodology-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(245, 158, 11, 0.2);
  }

  .methodology-number {
    min-width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }

  .technical-section {
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .learning-item {
    display: flex;
    align-items: start;
    gap: 1rem;
  }
